<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <h2 class="text-heading font-semibold text-center mb-10 text-gray-900">Manufacturing Excellence</h2>
    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-8">
      {[
        { id: 'IQC', label: 'Incoming QC', desc: 'Raw material inspection' },
        { id: 'IPQC', label: 'In-Process QC', desc: 'Production monitoring' },
        { id: 'FQC', label: 'Final QC', desc: 'Finished product check' },
        { id: 'OQC', label: 'Outgoing QC', desc: 'Pre-shipment audit' },
      ].map((step, i, arr) => (
        <>
          <div class="proof-card text-center w-36 md:w-44">
            <span class="text-2xl font-semibold text-primary">{step.id}</span>
            <p class="text-caption font-semibold mt-1">{step.label}</p>
            <p class="text-small text-gray-600">{step.desc}</p>
          </div>
          {i < arr.length - 1 && (
            <span class="i-carbon-arrow-right text-2xl text-gray-300 hidden md:block" aria-hidden="true"></span>
          )}
        </>
      ))}
    </div>
  </div>
</section>
