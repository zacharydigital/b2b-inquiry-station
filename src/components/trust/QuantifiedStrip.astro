---
export interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<section class="bg-primary-900 text-white border-y border-primary-900">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 py-9">
      {items.map((item) => (
        <div class="text-center border-white/10 md:border-l first:border-l-0">
          <p class="text-2xl font-bold">{item.value}</p>
          <p class="text-caption text-primary-100 mt-1">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
