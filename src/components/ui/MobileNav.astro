---
export interface Props {
  nav: { label: string; href: string }[];
  currentLocale?: string;
}

const { nav } = Astro.props;
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 lg:hidden bg-white transform translate-x-full transition-transform duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile menu"
>
  <div class="flex items-center justify-between h-16 px-4 border-b border-gray-100">
    <span class="font-semibold text-lg">Menu</span>
    <button id="mobile-menu-close" class="p-2" aria-label="Close menu">
      <span class="i-carbon-close text-xl" />
    </button>
  </div>
  <nav class="px-4 py-6 space-y-4">
    {nav.map((item) => (
      <a
        href={item.href}
        class="block text-subhead text-gray-900 font-medium py-2 border-b border-gray-100"
      >
        {item.label}
      </a>
    ))}
    <a href="/contact/" class="btn-primary w-full text-center mt-6">
      Get a Quote
    </a>
  </nav>
</div>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const menu = document.getElementById('mobile-menu');
  const close = document.getElementById('mobile-menu-close');

  trigger?.addEventListener('click', () => {
    menu?.classList.remove('translate-x-full');
  });
  close?.addEventListener('click', () => {
    menu?.classList.add('translate-x-full');
  });
</script>
