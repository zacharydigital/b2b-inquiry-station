---
export interface RelatedProduct {
  slug: string;
  title: string;
  model: string;
  image?: string;
}

export interface Props {
  products: RelatedProduct[];
}

const { products } = Astro.props;
---

<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <h2 class="text-heading font-bold text-center mb-10 text-gray-900">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {products.map((p) => (
        <a href={`/products/${p.slug}/`} class="card hover:shadow-elevated transition-shadow text-center group">
          <div class="w-full aspect-square bg-primary-50 rounded-card mb-3 overflow-hidden">
            {p.image ? (
              <img src={p.image} alt={p.title} class="w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-4xl">⚙</div>
            )}
          </div>
          <h4 class="font-semibold text-caption group-hover:text-primary transition-colors line-clamp-1">{p.title}</h4>
          <p class="text-small text-gray-400">{p.model}</p>
        </a>
      ))}
    </div>
  </div>
</section>
