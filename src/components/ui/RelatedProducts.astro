---
export interface RelatedProduct {
  slug: string;
  title: string;
  model: string;
  image?: string;
}

export interface Props {
  products: RelatedProduct[];
}

const { products } = Astro.props;
---

<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <p class="section-kicker mb-2">Shortlist alternatives</p>
      <h2 class="section-heading">Related Products</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {products.map((p) => (
        <a href={`/products/${p.slug}/`} class="product-card text-left group">
          <div class="media-frame aspect-[4/3] overflow-hidden p-4 flex items-center justify-center">
            {p.image ? (
              <img src={p.image} alt={p.title} class="w-full h-full object-contain" loading="lazy" />
            ) : (
              <span class="i-carbon-assembly text-4xl text-primary m-auto"></span>
            )}
          </div>
          <div class="p-4">
            <h4 class="font-semibold text-caption group-hover:text-primary transition-colors line-clamp-1">{p.title}</h4>
            <p class="text-small text-gray-600 mt-1">{p.model}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
