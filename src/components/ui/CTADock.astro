---
import { getVerticalConfig, normalizeVertical, type ProductVertical } from '../../lib/verticals';
import InquiryCTA from '../inquiry/InquiryCTA.astro';

export interface Props {
  vertical?: ProductVertical;
  ctaHref?: string;
}

const { vertical = 'machinery', ctaHref = '/get-a-quote/#rfq-form' } = Astro.props;
const config = getVerticalConfig(normalizeVertical(vertical));
---

<div class="mobile-cta-dock">
  <InquiryCTA href={ctaHref} icon="i-carbon-email-new" class="flex-1 text-center !text-sm whitespace-nowrap">
    {config.cta.mobilePrimary}
  </InquiryCTA>
  <a
    href="https://wa.me/1234567890"
    class="btn-outline flex-1 text-center !text-sm whitespace-nowrap"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="i-carbon-chat" aria-hidden="true"></span>
    WhatsApp
  </a>
</div>
