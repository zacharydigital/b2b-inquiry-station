---
export interface Props {
  productName: string;
}

const { productName } = Astro.props;
---

<section class="bg-primary-900 text-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
  <div class="container mx-auto px-4 text-center max-w-2xl">
    <h2 class="text-heading font-semibold mb-4">Ready to source {productName}? Let's talk.</h2>
    <p class="text-subhead text-primary-100 mb-8">
      Reply within 12 hours · Sample cost deductible · NDA available · No spam
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#inline-inquiry" class="btn-inquiry !px-8 !py-4">
        Request a Quote
      </a>
      <a href="https://wa.me/1234567890" target="_blank" rel="noopener noreferrer"
        class="btn-outline !px-8 !py-4 border-white/30 !text-white hover:bg-white/10">
        WhatsApp Us
      </a>
    </div>
  </div>
</section>
