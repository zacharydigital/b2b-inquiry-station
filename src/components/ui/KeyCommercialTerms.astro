---
export interface Props {
  items: { label: string; value: string; subtext: string }[];
}

const { items } = Astro.props;
---

<section class="bg-white border-y border-gray-100 py-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
      {items.map((item) => (
        <div class="metric-card !p-4">
          <p class="text-small text-gray-600">{item.label}</p>
          <p class="font-semibold text-body text-gray-900 mt-1">{item.value}</p>
          {item.subtext && <p class="text-small text-gray-600 mt-1">{item.subtext}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
