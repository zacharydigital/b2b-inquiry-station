---
import { breadcrumbSchema } from '../../lib/seo';

export interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  items: Crumb[];
  includeSchema?: boolean;
}

const { items, includeSchema = true } = Astro.props;
const schema = breadcrumbSchema(items.map((i) => ({ name: i.label, url: i.href })));
---

<nav aria-label="Breadcrumb" class="text-caption text-gray-600 py-4">
  <ol class="flex flex-wrap gap-x-2">
    {items.map((item, i) => (
      <li class="inline-flex items-center gap-x-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < items.length - 1 ? (
          <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
        ) : (
          <span class="text-gray-900 font-medium" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

{includeSchema && <script type="application/ld+json" set:html={schema} />}
