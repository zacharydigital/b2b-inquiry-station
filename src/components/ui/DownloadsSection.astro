---
import { isEmailGateOpen, emailGateFile } from '../../lib/store';

export interface Props {
  productSlug: string;
}
const { productSlug } = Astro.props;
---

<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <p class="section-kicker mb-2">Procurement files</p>
      <h2 class="section-heading">Downloads</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
      {[
        { type: 'Datasheet PDF', icon: 'i-carbon-document-pdf', desc: 'Product datasheet', fileType: 'datasheet' },
        { type: 'Full Catalog', icon: 'i-carbon-book', desc: 'Complete product catalog', fileType: 'catalog' },
        { type: 'Installation Guide', icon: 'i-carbon-task-settings', desc: 'Setup and maintenance', fileType: 'guide' },
      ].map((dl) => (
        <button
          class="proof-card text-left download-trigger"
          data-file-type={dl.fileType}
          data-product={productSlug}
        >
          <span class={`${dl.icon} text-3xl mb-4 block text-primary`} aria-hidden="true"></span>
          <h4 class="font-semibold text-caption">{dl.type}</h4>
          <p class="text-small text-gray-600 mt-1">{dl.desc}</p>
          <span class="inline-flex items-center gap-1 mt-4 text-small text-primary font-semibold">Request file <span class="i-carbon-arrow-right" aria-hidden="true"></span></span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { isEmailGateOpen, emailGateFile } from '../../lib/store';

  document.querySelectorAll('.download-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const fileType = (btn as HTMLElement).dataset.fileType!;
      const product = (btn as HTMLElement).dataset.product!;
      emailGateFile.set({ productSlug: product, fileType });
      isEmailGateOpen.set(true);
    });
  });
</script>
