---
import LocaleSwitcher from './LocaleSwitcher.astro';

export interface Props {
  logo?: string;
  nav: { label: string; href: string }[];
  currentLocale?: string;
  locales?: { code: string; label: string }[];
}

const {
  logo = '/static/logo.svg',
  nav,
  currentLocale = 'en',
  locales = [
    { code: 'en', label: 'English' },
    { code: 'es', label: 'Español' },
  ],
} = Astro.props;
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-40">
  <div class="container mx-auto flex items-center justify-between h-16 px-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src={logo} alt="Logo" class="h-8 w-auto" width="32" height="32" />
      <span class="font-semibold text-lg text-gray-900 hidden sm:block">IndustryPro</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-caption text-gray-600 hover:text-primary transition-colors font-medium"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-4">
      <LocaleSwitcher currentLocale={currentLocale} locales={locales} />
      <a href="/get-a-quote/" class="btn-primary !text-sm hidden sm:inline-flex">
        Get a Quote
      </a>
      <!-- Mobile menu trigger -->
      <button
        class="lg:hidden flex items-center p-2"
        id="mobile-menu-trigger"
        aria-label="Toggle menu"
      >
        <span class="i-carbon-menu text-xl text-gray-900" />
      </button>
    </div>
  </div>
</header>
