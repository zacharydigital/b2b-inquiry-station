---
import LocaleSwitcher from './LocaleSwitcher.astro';
import InquiryCTA from '../inquiry/InquiryCTA.astro';

export interface Props {
  logo?: string;
  nav: { label: string; href: string }[];
  currentLocale?: string;
  locales?: { code: string; label: string }[];
}

const {
  logo = '/static/logo.svg',
  nav,
  currentLocale = 'en',
  locales = [
    { code: 'en', label: 'English' },
    { code: 'es', label: 'Español' },
  ],
} = Astro.props;
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-[var(--z-header)]">
  <div class="container mx-auto flex items-center justify-between h-[var(--header-height)] px-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src={logo} alt="Logo" class="h-8 w-auto" width="32" height="32" />
      <span class="font-semibold text-lg text-gray-900 hidden sm:block">IndustryPro</span>
      <span class="hidden xl:inline-flex ml-2 border-l border-gray-100 pl-3 text-small text-gray-600">ISO 9001 Export Supplier</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-stretch h-full" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-caption text-gray-600 hover:text-primary hover:bg-primary-50 transition-colors duration-[var(--motion-duration-fast)] px-4 h-[var(--header-height)] inline-flex items-center border-l border-gray-100 first:border-l-0"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-4">
      <LocaleSwitcher currentLocale={currentLocale} locales={locales} />
      <InquiryCTA href="/get-a-quote/" icon="i-carbon-email-new text-base" class="hidden sm:inline-flex">
        Get a Quote
      </InquiryCTA>
      <!-- Mobile menu trigger -->
      <button
        class="lg:hidden flex items-center p-2"
        id="mobile-menu-trigger"
        aria-label="Toggle menu"
      >
        <span class="i-carbon-menu text-xl text-gray-900" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
