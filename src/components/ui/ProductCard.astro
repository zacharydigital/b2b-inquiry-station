---
export interface Props {
  slug: string;
  title: string;
  model: string;
  image?: string;
  category?: string;
  moq?: string;
  leadTime?: string;
}

const {
  slug,
  title,
  model,
  image = '/static/placeholder.jpg',
  category = '',
  moq = '100 pcs',
  leadTime = '15–25 days',
} = Astro.props;
---

<a href={`/products/${slug}/`} class="card hover:shadow-elevated transition-shadow group block">
  <div class="aspect-square bg-primary-50 rounded-card mb-4 overflow-hidden">
    <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
  </div>
  <h3 class="font-semibold text-caption mb-2 group-hover:text-primary transition-colors line-clamp-2">{title}</h3>
  <p class="text-small text-gray-400 mb-3">Model: {model}</p>
  <div class="flex justify-between text-small text-gray-600">
    <span>MOQ: {moq}</span>
    <span>Lead: {leadTime}</span>
  </div>
  <span class="inline-block mt-3 text-small text-primary font-medium group-hover:underline">
    Inquire Now →
  </span>
</a>
