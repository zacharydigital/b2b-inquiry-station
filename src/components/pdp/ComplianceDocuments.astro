---
import type { ComplianceDocument } from '../../lib/products';

export interface Props {
  documents?: ComplianceDocument[];
  certifications?: string[];
}

const { documents = [], certifications = [] } = Astro.props;
const items = documents.length
  ? documents
  : certifications.map((name) => ({
      name,
      status: 'Available',
      detail: 'Document can be shared during RFQ review or before shipment.',
    }));
---

{items.length > 0 && (
  <section class="section-band">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-8">
        <p class="section-kicker mb-2">Compliance proof</p>
        <h2 class="section-heading mb-4">Documents Buyers Can Request Before Purchase</h2>
        <p class="text-body text-gray-600 leading-relaxed">
          Reduce sourcing risk with document availability, batch traceability, and export-ready compliance evidence.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {items.map((doc) => (
          <article class="proof-card">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-semibold text-gray-900">{doc.name}</h3>
              <span class="text-small text-success font-semibold">{doc.status}</span>
            </div>
            <p class="text-caption text-gray-600 leading-relaxed">{doc.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
