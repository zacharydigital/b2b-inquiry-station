---
import type { CustomizationOption } from '../../lib/products';

export interface Props {
  items?: CustomizationOption[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="section-band">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-8">
        <p class="section-kicker mb-2">Customization scope</p>
        <h2 class="section-heading mb-4">What Can Be Customized for OEM / ODM</h2>
        <p class="text-body text-gray-600 leading-relaxed">
          Use this scope to prepare artwork, packaging files, compliance questions, and MOQ expectations before starting an OEM project.
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        {items.map((item) => (
          <article class="proof-card">
            <h3 class="font-semibold text-gray-900 mb-4">{item.area}</h3>
            <ul class="space-y-2 text-caption text-gray-600">
              {item.options.map((option) => (
                <li class="flex gap-2">
                  <span class="i-carbon-checkmark text-success mt-0.5" aria-hidden="true"></span>
                  <span>{option}</span>
                </li>
              ))}
            </ul>
            {item.moqImpact && <p class="mt-4 text-small text-gray-600 border-t border-hairline pt-4">{item.moqImpact}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
