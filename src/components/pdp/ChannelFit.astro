---
import type { ChannelFit as ChannelFitItem } from '../../lib/products';

export interface Props {
  items?: ChannelFitItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="bg-white border-y border-hairline" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-8">
        <p class="section-kicker mb-2">Channel fit</p>
        <h2 class="section-heading mb-4">Where This Product Fits Commercially</h2>
        <p class="text-body text-gray-600 leading-relaxed">
          Confirm whether the product is better suited for marketplace retail, distribution, private label, or campaign sourcing before quotation.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {items.map((item) => (
          <article class="metric-card">
            <p class="text-small text-primary font-semibold mb-2">{item.channel}</p>
            <h3 class="text-subhead font-semibold text-gray-900 mb-3">{item.fit}</h3>
            <p class="text-caption text-gray-600 leading-relaxed">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
