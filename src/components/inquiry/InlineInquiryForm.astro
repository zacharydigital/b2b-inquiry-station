---
import InquiryFields from './InquiryFields.astro';
import {
  getInquiryFields,
  getVerticalConfig,
  normalizeVertical,
  type ProductVertical,
} from '../../lib/verticals';

export interface Props {
  productSlug?: string;
  productName?: string;
  industry?: ProductVertical;
  vertical?: ProductVertical;
  locale?: string;
}

const {
  productSlug = '',
  productName = '',
  industry,
  vertical = industry || 'machinery',
  locale = 'en',
} = Astro.props;
const normalizedVertical = normalizeVertical(vertical);
const config = getVerticalConfig(normalizedVertical);
const fields = getInquiryFields(normalizedVertical, 'full');
const hiddenFields = [
  productSlug ? 'product_slug' : '',
  productName ? 'product_interest' : '',
  productName ? 'material_grade' : '',
].filter(Boolean);
const hasVisibleInquiryType = fields.some((field) => field.name === 'inquiry_type' && !hiddenFields.includes(field.name));
---

<div class="quote-panel p-6 sm:p-8" id="inline-inquiry">
  <p class="section-kicker mb-2">RFQ desk</p>
  <h3 class="section-heading mb-2">{config.cta.primary}</h3>
  <p class="text-caption text-gray-600 mb-6">Reply within 12 hours · No spam · NDA available</p>

  <form
    class="inquiry-form space-y-4"
    method="POST"
    action="/api/inquiry"
    enctype="multipart/form-data"
  >
    <input type="hidden" name="website_url" tabindex="-1" autocomplete="off" class="hidden" />
    <input type="hidden" name="product_slug" value={productSlug} />
    <input type="hidden" name="product_name" value={productName} />
    {productName && <input type="hidden" name="product_interest" value={productName} />}
    {productName && <input type="hidden" name="material_grade" value={productName} />}
    <input type="hidden" name="industry" value={normalizedVertical} />
    {!hasVisibleInquiryType && <input type="hidden" name="inquiry_type" value="single" />}
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="source_page" id="inquiry-source-page" value="" />
    <input type="hidden" name="utm_source" id="inquiry-utm-source" value="" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <InquiryFields fields={fields} hiddenFields={hiddenFields} />
    </div>
    <button type="submit" class="btn-inquiry w-full text-center" data-submit-label={config.cta.primary}>
      {config.cta.primary}
    </button>
    <p class="hidden text-small text-primary text-center" data-form-status aria-live="polite">
      Submitting your request...
    </p>
    <p class="text-small text-gray-600 text-center flex items-center justify-center gap-1">
      <span class="i-carbon-locked" aria-hidden="true"></span>Your info is safe. We never share or spam.
    </p>
  </form>
</div>

<script>
  document.querySelectorAll('.inquiry-form').forEach((form) => {
    const srcInput = form.querySelector('#inquiry-source-page') as HTMLInputElement;
    if (srcInput) srcInput.value = window.location.href;
    const utmInput = form.querySelector('#inquiry-utm-source') as HTMLInputElement;
    if (utmInput) utmInput.value = new URLSearchParams(window.location.search).get('utm_source') || '';
    form.querySelectorAll('[data-error-target]').forEach((field) => {
      field.addEventListener('input', () => {
        const input = field as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        const error = form.querySelector(`[data-field-error="${input.name}"]`) as HTMLElement;
        if (error && input.checkValidity()) error.classList.add('hidden');
      });
    });
    form.addEventListener('submit', (e) => {
      const htmlForm = form as HTMLFormElement;
      if (!htmlForm.checkValidity()) {
        e.preventDefault();
        htmlForm.querySelectorAll('[data-error-target]').forEach((field) => {
          const input = field as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          const error = htmlForm.querySelector(`[data-field-error="${input.name}"]`) as HTMLElement;
          if (error) error.classList.toggle('hidden', input.checkValidity());
        });
        htmlForm.reportValidity();
        return;
      }
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const status = form.querySelector('[data-form-status]') as HTMLElement;
      if (button) {
        button.disabled = true;
        button.textContent = 'Submitting...';
        button.classList.add('opacity-75', 'cursor-wait');
      }
      if (status) status.classList.remove('hidden');
    });
  });
</script>
