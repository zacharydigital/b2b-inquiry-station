---
import InquiryFields from './InquiryFields.astro';
import {
  getInquiryFields,
  getVerticalConfig,
  normalizeVertical,
  type ProductVertical,
} from '../../lib/verticals';

export interface Props {
  industry?: ProductVertical;
  vertical?: ProductVertical;
  locale?: string;
  title?: string;
  subtitle?: string;
  inquiryType?: string;
  submitLabel?: string;
}

const {
  industry,
  vertical = industry || 'machinery',
  locale = 'en',
  title = 'Ready to Source Quality Products?',
  subtitle = 'Reply within 12 hours · NDA available · No spam, no reselling',
  inquiryType = 'contact',
  submitLabel,
} = Astro.props;
const normalizedVertical = normalizeVertical(vertical);
const config = getVerticalConfig(normalizedVertical);
const fields = getInquiryFields(normalizedVertical, 'full');
const hasVisibleInquiryType = fields.some((field) => field.name === 'inquiry_type');
const resolvedSubmitLabel = submitLabel || config.cta.primary;
---

<section class="bg-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="mb-8">
      <p class="section-kicker mb-2">Sales engineering intake</p>
      <h2 class="section-heading mb-4">{title}</h2>
      <p class="text-subhead text-gray-600">
        {subtitle}
      </p>
    </div>

    <form
      method="POST"
      action="/api/inquiry"
      enctype="multipart/form-data"
      class="inquiry-form quote-panel space-y-5 p-6 sm:p-8"
    >
      <input type="hidden" name="website_url" tabindex="-1" autocomplete="off" class="hidden" />
      <input type="hidden" name="industry" value={normalizedVertical} />
      {!hasVisibleInquiryType && <input type="hidden" name="inquiry_type" value={inquiryType} />}
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="source_page" id="contact-source-page" value="" />
      <input type="hidden" name="utm_source" id="contact-utm-source" value="" />
      <input type="hidden" name="cart_items" id="contact-cart-items" value="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <InquiryFields fields={fields} />
      </div>

      <button type="submit" class="btn-inquiry w-full py-3 text-center text-lg" data-submit-label={resolvedSubmitLabel}>
        {resolvedSubmitLabel}
      </button>
      <p class="hidden text-small text-primary text-center" data-form-status aria-live="polite">
        Submitting your request...
      </p>

      <p class="text-small text-gray-400 text-center">
        Your info is safe. We never share or spam. GDPR compliant.
      </p>
    </form>
  </div>
</section>

<script>
  const sourceInput = document.getElementById('contact-source-page') as HTMLInputElement;
  if (sourceInput) sourceInput.value = window.location.href;

  const utmInput = document.getElementById('contact-utm-source') as HTMLInputElement;
  if (utmInput) utmInput.value = new URLSearchParams(window.location.search).get('utm_source') || '';

  const cart = localStorage.getItem('quote_cart');
  if (cart) {
    const el = document.getElementById('contact-cart-items') as HTMLInputElement;
    if (el) el.value = cart;
    localStorage.removeItem('quote_cart');
    // Switch inquiry type to rfq when cart is present
    const typeEl = document.querySelector('input[name="inquiry_type"]') as HTMLInputElement;
    if (typeEl) typeEl.value = 'rfq';
  }

  document.querySelectorAll('.inquiry-form').forEach((form) => {
    form.querySelectorAll('[data-error-target]').forEach((field) => {
      field.addEventListener('input', () => {
        const input = field as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        const error = form.querySelector(`[data-field-error="${input.name}"]`) as HTMLElement;
        if (error && input.checkValidity()) error.classList.add('hidden');
      });
    });
    form.addEventListener('submit', (event) => {
      const htmlForm = form as HTMLFormElement;
      if (!htmlForm.checkValidity()) {
        event.preventDefault();
        htmlForm.querySelectorAll('[data-error-target]').forEach((field) => {
          const input = field as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          const error = htmlForm.querySelector(`[data-field-error="${input.name}"]`) as HTMLElement;
          if (error) error.classList.toggle('hidden', input.checkValidity());
        });
        htmlForm.reportValidity();
        return;
      }
      const button = htmlForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const status = htmlForm.querySelector('[data-form-status]') as HTMLElement;
      if (button) {
        button.disabled = true;
        button.textContent = 'Submitting...';
        button.classList.add('opacity-75', 'cursor-wait');
      }
      if (status) status.classList.remove('hidden');
    });
  });
</script>
