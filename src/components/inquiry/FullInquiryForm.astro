---
export interface Props {
  industry?: string;
  locale?: string;
  title?: string;
  subtitle?: string;
  inquiryType?: string;
  submitLabel?: string;
}

const {
  industry = 'machinery',
  locale = 'en',
  title = 'Ready to Source Quality Products?',
  subtitle = 'Reply within 12 hours · NDA available · No spam, no reselling',
  inquiryType = 'contact',
  submitLabel = 'Get My Quote →',
} = Astro.props;
---

<section class="bg-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
  <div class="container mx-auto px-4 max-w-2xl">
    <div class="text-center mb-10">
      <h2 class="text-heading font-bold text-gray-900 mb-4">{title}</h2>
      <p class="text-subhead text-gray-600">
        {subtitle}
      </p>
    </div>

    <form
      method="POST"
      action="/api/inquiry"
      enctype="multipart/form-data"
      class="inquiry-form space-y-5"
    >
      <input type="hidden" name="website_url" tabindex="-1" autocomplete="off" class="hidden" />
      <input type="hidden" name="industry" value={industry} />
      <input type="hidden" name="inquiry_type" value={inquiryType} />
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="source_page" id="contact-source-page" value="" />
      <input type="hidden" name="utm_source" id="contact-utm-source" value="" />
      <input type="hidden" name="cart_items" id="contact-cart-items" value="" />

      <div>
        <label class="block text-small font-medium text-gray-900 mb-1">Email *</label>
        <input type="email" name="email" required
          class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-small font-medium text-gray-900 mb-1">Name *</label>
          <input type="text" name="name" required
            class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
        </div>
        <div>
          <label class="block text-small font-medium text-gray-900 mb-1">Country *</label>
          <input type="text" name="country" required
            class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-small font-medium text-gray-900 mb-1">Company</label>
          <input type="text" name="company"
            class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
        </div>
        <div>
          <label class="block text-small font-medium text-gray-900 mb-1">Phone / WhatsApp</label>
          <input type="tel" name="phone"
            class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
        </div>
      </div>

      <div>
        <label class="block text-small font-medium text-gray-900 mb-1">Product / Service You're Interested In</label>
        <select name="product_slug"
          class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors bg-white">
          <option value="">I'm not sure yet — please recommend</option>
          <option value="gearboxes">Gearboxes</option>
          <option value="motors">Electric Motors</option>
          <option value="pumps">Pumps & Valves</option>
          <option value="custom">Custom / OEM Project</option>
        </select>
      </div>

      <div>
        <label class="block text-small font-medium text-gray-900 mb-1">Tell us about your requirements *</label>
        <textarea name="message" required rows={4}
          class="w-full border border-gray-300 rounded-input px-4 py-3 focus:outline-none focus:border-primary transition-colors resize-y"
          placeholder="Describe your requirements, quantity, timeline, or any specific questions..."></textarea>
      </div>

      <div>
        <label class="block text-small font-medium text-gray-900 mb-1">Upload drawing / specs (PDF, max 10MB)</label>
        <input type="file" name="file"
          class="w-full border border-gray-300 rounded-input px-4 py-2 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-primary-50 file:text-primary file:font-medium file:cursor-pointer" />
      </div>

      <button type="submit" class="btn-primary w-full py-3 text-center text-lg" data-submit-label={submitLabel}>
        {submitLabel}
      </button>
      <p class="hidden text-small text-primary text-center" data-form-status aria-live="polite">
        Submitting your request...
      </p>

      <p class="text-small text-gray-400 text-center">
        🔒 Your info is safe. We never share or spam. GDPR compliant.
      </p>
    </form>
  </div>
</section>

<script>
  const sourceInput = document.getElementById('contact-source-page') as HTMLInputElement;
  if (sourceInput) sourceInput.value = window.location.href;

  const utmInput = document.getElementById('contact-utm-source') as HTMLInputElement;
  if (utmInput) utmInput.value = new URLSearchParams(window.location.search).get('utm_source') || '';

  const cart = localStorage.getItem('quote_cart');
  if (cart) {
    const el = document.getElementById('contact-cart-items') as HTMLInputElement;
    if (el) el.value = cart;
    localStorage.removeItem('quote_cart');
    // Switch inquiry type to rfq when cart is present
    const typeEl = document.querySelector('input[name="inquiry_type"]') as HTMLInputElement;
    if (typeEl) typeEl.value = 'rfq';
  }

  document.querySelectorAll('.inquiry-form').forEach((form) => {
    form.addEventListener('submit', () => {
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const status = form.querySelector('[data-form-status]') as HTMLElement;
      if (button) {
        button.disabled = true;
        button.textContent = 'Submitting...';
        button.classList.add('opacity-75', 'cursor-wait');
      }
      if (status) status.classList.remove('hidden');
    });
  });
</script>
