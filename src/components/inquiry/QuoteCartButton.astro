<button
  id="quote-cart-fab"
  class="quote-cart-trigger"
  aria-label="Open quote cart"
>
  <span class="i-carbon-shopping-cart text-xl" aria-hidden="true"></span>
  <span
    id="cart-badge"
    class="quote-cart-badge"
  >0</span>
</button>

<script>
  import { isCartOpen, getCartCount } from '../../lib/store';

  // Show button if cart has items
  function updateButton() {
    const btn = document.getElementById('quote-cart-fab');
    const badge = document.getElementById('cart-badge');
    if (!btn || !badge) return;
    const count = getCartCount();
    if (count > 0) {
      btn.classList.remove('hidden');
      btn.classList.add('flex');
      badge.textContent = String(count);
      badge.classList.remove('hidden');
    } else {
      btn.classList.add('hidden');
      btn.classList.remove('flex');
    }
  }

  document.getElementById('quote-cart-fab')?.addEventListener('click', () => {
    isCartOpen.set(true);
  });

  // Poll for updates
  setInterval(updateButton, 1000);
</script>
