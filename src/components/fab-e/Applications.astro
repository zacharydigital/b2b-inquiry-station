---
export interface AppCard {
  name: string;
  description: string;
  image?: string;
}

export interface Props { applications: AppCard[]; }

const { applications } = Astro.props;
---

<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <h2 class="text-heading font-bold text-center mb-10 text-gray-900">Applications</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {applications.map((app) => (
        <div class="proof-card text-left">
          <div class="w-12 h-12 bg-primary-50 rounded-[var(--radius-card)] mb-4 flex items-center justify-center">
            {app.image ? <img src={app.image} alt={app.name} class="w-8 h-8" /> : <span class="i-carbon-tools text-2xl text-primary" aria-hidden="true"></span>}
          </div>
          <h4 class="font-semibold text-caption mb-1">{app.name}</h4>
          <p class="text-small text-gray-600">{app.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
