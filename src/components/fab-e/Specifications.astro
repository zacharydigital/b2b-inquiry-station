---
export interface Spec {
  parameter: string;
  value: string;
  note?: string;
}

export interface Props { specs: Spec[]; }

const { specs } = Astro.props;
const visibleCount = 8;
---

<section style="padding-top: var(--space-block); padding-bottom: var(--space-block)">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mb-8">
      <p class="section-kicker mb-2">Technical fit</p>
      <h2 class="section-heading">Technical Specifications</h2>
    </div>
    <div class="table-surface">
      <table class="table-procurement">
        <thead class="bg-[var(--table-header-bg)]">
          <tr>
            <th class="table-header-cell">Parameter</th>
            <th class="table-header-cell">Value</th>
            <th class="table-header-cell hidden md:table-cell">Note</th>
          </tr>
        </thead>
        <tbody id="spec-tbody">
          {specs.map((s, i) => (
            <tr class={`border-b border-gray-100 ${i >= visibleCount ? 'spec-hidden hidden' : ''}`}>
              <td class="table-cell font-semibold text-gray-900">{s.parameter}</td>
              <td class="table-cell">{s.value}</td>
              <td class="table-cell text-small text-gray-400 hidden md:table-cell">{s.note || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {specs.length > visibleCount && (
      <button id="spec-toggle" class="mt-4 text-caption text-primary font-medium hover:text-primary-900 mx-auto block">
        Show all {specs.length} specs ▼
      </button>
    )}
  </div>
</section>

<script>
  document.getElementById('spec-toggle')?.addEventListener('click', function () {
    const hidden = document.querySelectorAll('.spec-hidden');
    const isHidden = hidden[0]?.classList.contains('hidden');
    hidden.forEach((el) => el.classList.toggle('hidden', !isHidden));
    this.textContent = isHidden
      ? 'Show fewer specs ▲'
      : 'Show all specs ▼';
  });
</script>
