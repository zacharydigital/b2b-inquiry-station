---
export interface Props {
  advantages: { title: string; description: string; image?: string }[];
}

const { advantages } = Astro.props;
---

<section class="bg-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mb-10">
      <p class="section-kicker mb-2">Engineering advantages</p>
      <h2 class="section-heading">Features & Advantages</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {advantages.map((adv) => (
        <article class="proof-card">
          <div class="w-11 h-11 rounded-[var(--radius-card)] bg-primary-50 text-primary flex items-center justify-center mb-5">
            <span class="i-carbon-settings-check text-2xl" aria-hidden="true"></span>
          </div>
          <h3 class="text-subhead font-normal text-gray-900 mb-3">{adv.title}</h3>
          <p class="text-caption leading-relaxed text-gray-600">{adv.description}</p>
          <a href="#inline-inquiry" class="inline-flex items-center gap-2 mt-5 text-caption text-primary font-semibold hover:text-primary-900">
            Inquire About This <span class="i-carbon-arrow-right" aria-hidden="true"></span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
