---
import BaseLayout from '../components/ui/BaseLayout.astro';

const title = 'Thank You — Inquiry Received | IndustryPro';
const desc = 'Your inquiry has been received. We will reply within 12 business hours.';
---

<BaseLayout title={title} description={desc} noindex={true}>
  <section class="min-h-screen flex items-center justify-center bg-white">
    <div class="container mx-auto px-4 text-center max-w-lg">
      <span class="text-6xl mb-6 block">✅</span>
      <h1 class="text-display font-bold text-gray-900 mb-4">Thank You!</h1>
      <p class="text-subhead text-gray-600 mb-2">Your inquiry has been received.</p>
      <p class="text-caption text-gray-600 mb-8">
        We will reply within <strong class="text-gray-900">12 business hours</strong>.
        Check your inbox for a confirmation email.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products/" class="btn-primary">Browse More Products</a>
        <a href="/" class="btn-outline">Back to Home</a>
      </div>
      <p class="mt-12 text-small text-gray-400">
        🔒 No spam · No reselling · GDPR compliant
      </p>
    </div>
  </section>
</BaseLayout>
