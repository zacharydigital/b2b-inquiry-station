---
import BaseLayout from '../components/ui/BaseLayout.astro';
import QuantifiedStrip from '../components/trust/QuantifiedStrip.astro';
import CertLogoWall from '../components/trust/CertLogoWall.astro';
import ClientLogoWall from '../components/trust/ClientLogoWall.astro';
import TestimonialCards from '../components/trust/TestimonialCards.astro';
import ProdFlowDiagram from '../components/trust/ProdFlowDiagram.astro';
import TeamPhotoCards from '../components/trust/TeamPhotoCards.astro';

const title = 'IndustryPro — Industrial Machinery Manufacturer';
const description = 'Professional industrial machinery manufacturer. ISO 9001 certified factory. OEM/ODM supported. Global shipping to 60+ countries.';
---

<BaseLayout title={title} description={description}>
  <section class="industrial-grid-bg border-b border-gray-100" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <p class="section-kicker mb-4">ISO 9001 factory · OEM/ODM · Export documentation</p>
          <h1 class="text-display font-bold leading-tight text-gray-900 max-w-3xl">
            Industrial machinery supplier built for procurement teams.
          </h1>
          <p class="mt-6 text-subhead text-gray-600 max-w-2xl leading-relaxed">
            Compare gearboxes, motors, pumps, and OEM machinery with clear MOQ, lead time, compliance evidence, and RFQ-ready technical context.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/get-a-quote/" class="btn-primary !text-lg !px-8 !py-4">
              <span class="i-carbon-email-new" aria-hidden="true"></span>
              Request a Quote
            </a>
            <a href="/products/" class="btn-outline !text-lg !px-8 !py-4">
              <span class="i-carbon-search" aria-hidden="true"></span>
              View Products
            </a>
          </div>
          <div class="mt-7 grid grid-cols-1 sm:grid-cols-3 gap-3 text-caption text-gray-600">
            <span class="flex items-center gap-2"><span class="i-carbon-time text-primary" aria-hidden="true"></span> Reply within 12 hours</span>
            <span class="flex items-center gap-2"><span class="i-carbon-locked text-primary" aria-hidden="true"></span> NDA available</span>
            <span class="flex items-center gap-2"><span class="i-carbon-delivery text-primary" aria-hidden="true"></span> Global shipping</span>
          </div>
        </div>
        <aside class="lg:col-span-5">
          <div class="quote-panel p-0 overflow-hidden">
            <img src="/static/factory-floor.svg" alt="Factory floor production cells" class="w-full aspect-[16/10] object-cover" />
            <div class="p-6">
              <p class="text-small font-bold text-primary uppercase mb-3">Capability snapshot</p>
              <div class="grid grid-cols-2 gap-3">
                <div class="metric-card !p-4"><p class="text-small text-gray-600">Factory area</p><strong class="block text-body">20,000 m2</strong></div>
                <div class="metric-card !p-4"><p class="text-small text-gray-600">Monthly capacity</p><strong class="block text-body">50,000u</strong></div>
                <div class="metric-card !p-4"><p class="text-small text-gray-600">Export markets</p><strong class="block text-body">60+ countries</strong></div>
                <div class="metric-card !p-4"><p class="text-small text-gray-600">Compliance</p><strong class="block text-body">ISO / CE</strong></div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <QuantifiedStrip
    items={[
      { label: 'Years Established', value: '15+' },
      { label: 'Export Countries', value: '60+' },
      { label: 'Factory Area (m2)', value: '20,000' },
      { label: 'Happy Clients', value: '2,000+' },
      { label: 'Monthly Capacity', value: '50,000u' },
    ]}
  />

  <section class="bg-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-10">
        <div>
          <p class="section-kicker mb-2">Product families</p>
          <h2 class="section-heading">Shortlist by sourcing need</h2>
        </div>
        <a href="/compare/" class="btn-quiet">Compare all models <span class="i-carbon-arrow-right" aria-hidden="true"></span></a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Gearboxes', desc: 'Planetary and helical gearboxes for CNC, robotics, conveyors, and pump drives.', href: '/products/?category=gearboxes', icon: 'i-carbon-assembly' },
          { title: 'Electric Motors', desc: 'Servo and industrial motors with encoder, flange, and brake configuration options.', href: '/products/?category=motors', icon: 'i-carbon-power' },
          { title: 'Pumps & Valves', desc: 'Centrifugal pumps and process components with export-ready documentation.', href: '/products/?category=pumps', icon: 'i-carbon-flow' },
        ].map((cat) => (
          <a href={cat.href} class="proof-card group">
            <span class={`${cat.icon} text-3xl text-primary mb-5 block`} aria-hidden="true"></span>
            <h3 class="text-subhead font-bold mb-3 group-hover:text-primary transition-colors">{cat.title}</h3>
            <p class="text-caption text-gray-600 leading-relaxed">{cat.desc}</p>
            <span class="inline-flex items-center gap-2 mt-5 text-small text-primary font-bold">Open category <span class="i-carbon-arrow-right" aria-hidden="true"></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-5">
          <p class="section-kicker mb-2">Procurement workflow</p>
          <h2 class="section-heading mb-4">Evidence before samples, clarity before price.</h2>
          <p class="text-body text-gray-600 leading-relaxed">
            The template is structured around the questions sourcing teams ask before sending drawings: technical fit, commercial fit, compliance evidence, and shipping readiness.
          </p>
        </div>
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { title: 'Technical fit', detail: 'Specs, application notes, standards, and comparable models.' },
            { title: 'Commercial fit', detail: 'MOQ, lead time, samples, payment terms, and packaging.' },
            { title: 'Compliance pack', detail: 'Certificate copies, QC records, and shipment documents.' },
            { title: 'RFQ handoff', detail: 'Inquiry forms, quote cart, file upload, and buyer confirmation.' },
          ].map((item) => (
            <article class="metric-card">
              <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-caption text-gray-600 leading-relaxed">{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Proof: Certifications -->
  <CertLogoWall
    certs={[
      { name: 'ISO 9001:2015', number: 'CN-2021-ISO9001-XXXX', issuer: 'SGS', valid_until: '2027-06' },
      { name: 'CE', number: 'CE-2022-XXXX', issuer: 'TÜV Rheinland', valid_until: '2027-12' },
      { name: 'RoHS', number: 'ROHS-2023-XXXX', issuer: 'Intertek', valid_until: '2027-03' },
    ]}
  />

  <!-- 5. Trust: Client Logo Wall -->
  <ClientLogoWall
    clients={[
      { name: 'Siemens', logo: '/static/placeholder-logo.svg' },
      { name: 'ABB', logo: '/static/placeholder-logo.svg' },
      { name: 'Bosch', logo: '/static/placeholder-logo.svg' },
      { name: 'Rockwell', logo: '/static/placeholder-logo.svg' },
      { name: 'Schneider', logo: '/static/placeholder-logo.svg' },
    ]}
  />

  <!-- 6. Trust: Testimonials -->
  <TestimonialCards
    testimonials={[
      { name: 'James Wilson', company: 'Wilson Automation Ltd.', country: 'UK', quote: 'IndustryPro has been our primary gearbox supplier for 5 years. Consistent quality and excellent communication.' },
      { name: 'Luis Fernandez', company: 'TechnoMex SA', country: 'Mexico', quote: 'The team went above and beyond to customize a solution for our unique application.' },
    ]}
  />

  <!-- Extra: Manufacturing QC -->
  <ProdFlowDiagram />

  <!-- Extra: Team -->
  <TeamPhotoCards
    team={[
      { name: 'David Chen', role: 'CEO', linkedin: 'https://linkedin.com/in/example' },
      { name: 'Maria Santos', role: 'Sales Director', linkedin: 'https://linkedin.com/in/example' },
      { name: 'Thomas Mueller', role: 'QC Manager', linkedin: 'https://linkedin.com/in/example' },
    ]}
  />

  <!-- 7. Convert: Final CTA -->
  <section class="bg-primary-900 text-white" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-heading font-bold mb-4">Ready to Source Quality Machinery?</h2>
      <p class="text-subhead text-primary-100 mb-8">
        Reply within 12 hours. NDA available. No spam, no reselling.
      </p>
      <a href="/contact/" class="btn inline-flex items-center justify-center bg-accent hover:bg-accent-hover text-white px-8 py-4 rounded-[var(--radius-button)] font-semibold text-lg">
        Get Your Quote Now
      </a>
    </div>
  </section>
</BaseLayout>
