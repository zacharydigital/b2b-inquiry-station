---
import '../../styles/tokens.css';
import { getDesignTokenExport } from '../../lib/design-tokens';
import { getVerticalConfig, type ProductVertical } from '../../lib/verticals';

const tokens = getDesignTokenExport();
const verticals = Object.keys(tokens.verticals) as ProductVertical[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>B2B Inquiry Design System</title>
  </head>
  <body class="font-sans text-body text-gray-900 bg-white antialiased" data-vertical="machinery">
    <main>
      <section class="border-b border-hairline bg-white">
        <div class="container mx-auto px-4 py-10">
          <p class="section-kicker mb-3">Internal design language</p>
          <h1 class="text-display font-semibold leading-tight max-w-4xl">B2B Inquiry Design System</h1>
          <p class="mt-4 text-subhead text-gray-600 max-w-3xl leading-relaxed">
            A conversion-focused design language for export B2B PDPs, RFQ workflows, procurement proof, and multi-industry sourcing pages.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/design-system/tokens.json" class="btn-primary">Export tokens JSON</a>
            <a href="/products/" class="btn-outline">View product system</a>
          </div>
        </div>
      </section>

      <section class="section-band">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mb-8">
            <p class="section-kicker mb-2">Vertical overlays</p>
            <h2 class="section-heading mb-4">Industry-Specific Visual Modes</h2>
            <p class="text-body text-gray-600 leading-relaxed">
              Each vertical keeps the same enterprise inquiry core while adjusting proof color, CTA wording, PDP sequence, and form schema.
            </p>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            {verticals.map((vertical) => {
              const config = getVerticalConfig(vertical);
              const overlay = tokens.verticals[vertical];
              return (
                <article class="proof-card" data-vertical={vertical}>
                  <div class="h-2 mb-5 rounded-[var(--radius-input)]" style={`background:${overlay.primary}`}></div>
                  <p class="text-small text-primary font-semibold mb-2">{vertical}</p>
                  <h3 class="font-semibold text-gray-900 mb-3">{config.label}</h3>
                  <p class="text-caption text-gray-600 mb-5">Primary CTA: <strong class="text-gray-900">{config.cta.primary}</strong></p>
                  <div class="grid grid-cols-3 gap-2 text-small">
                    <span class="h-10 border border-hairline" style={`background:${overlay.primary}`}></span>
                    <span class="h-10 border border-hairline" style={`background:${overlay.accent}`}></span>
                    <span class="h-10 border border-hairline" style={`background:${overlay.proofBg}`}></span>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="bg-white border-y border-hairline" style="padding-top: var(--space-section); padding-bottom: var(--space-section)">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mb-8">
            <p class="section-kicker mb-2">Components</p>
            <h2 class="section-heading mb-4">Button, Form, and CTA Semantics</h2>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="quote-panel">
              <h3 class="font-semibold text-gray-900 mb-4">Buttons</h3>
              <div class="flex flex-wrap gap-3">
                <button class="btn-primary" type="button">Technical Action</button>
                <button class="btn-inquiry" type="button">Request a Quote</button>
                <button class="btn-outline" type="button">Secondary Action</button>
              </div>
              <p class="mt-4 text-caption text-gray-600">Orange inquiry buttons are reserved for RFQ, sample, quote, and conversion paths only.</p>
            </div>
            <form class="quote-panel">
              <h3 class="font-semibold text-gray-900 mb-4">Form states</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <label class="block text-small font-medium text-gray-900">Required field<input class="form-control mt-1" required placeholder="Buyer email" /></label>
                <label class="block text-small font-medium text-gray-900">Select field<select class="form-control mt-1"><option>Sample request</option><option>Bulk quote</option></select></label>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section class="section-band">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mb-8">
            <p class="section-kicker mb-2">PDP contract</p>
            <h2 class="section-heading mb-4">Module Order by Vertical</h2>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            {verticals.map((vertical) => {
              const config = getVerticalConfig(vertical);
              return (
                <article class="proof-card">
                  <h3 class="font-semibold text-gray-900 mb-4">{config.label}</h3>
                  <ol class="space-y-2 text-caption text-gray-600">
                    {config.pdpModules.map((module, index) => <li><span class="text-primary font-semibold">{index + 1}.</span> {module}</li>)}
                  </ol>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
